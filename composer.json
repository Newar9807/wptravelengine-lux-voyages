{
    "name": "wptravelengine/wte-lux-voyages",
    "description": "WP Travel Engine Lux Voyages Customization Addon",
    "type": "wordpress-plugin",
    "authors": [
        {
            "name": "WP Travel Engine",
            "email": "info@wptravelengine.com"
        }
    ],
    "require": {
        "php": ">=7.4",
		"codewing-solutions/wptravelengine-pro-config": "dev-main"
    },
	"repositories": [
		{
			"type": "vcs",
			"url": "git@github.com:Codewing-Solutions/wptravelengine-pro-config.git"
		}
	],
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.5",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
        "phpcompatibility/phpcompatibility-wp": "*",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "LuxVoyages\\": "includes/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
